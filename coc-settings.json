{
    "inlayHint.enable": false,
    "suggest.autoTrigger": "always",
    "suggest.triggerAfterInsertEnter": true,
    "suggest.enablePreview": true,
    "suggest.enablePreselect": false,
    "suggest.noselect": true,
    "suggest.timeout": 5000,
    "suggest.minTriggerInputLength": 1,
    "suggest.keepCompleteopt": false,
    "suggest.acceptSuggestionOnCommitCharacter": false,
    "diagnostic.errorSign": "✖",
    "diagnostic.warningSign": "⚠",
    "diagnostic.infoSign": "ℹ",
    "diagnostic.hintSign": "➤",
    "diagnostic.checkCurrentLine": true,
    "diagnostic.virtualText": false,
    "diagnostic.virtualTextCurrentLineOnly": false,
    "diagnostic.enableMessage": "always",
    "diagnostic.refreshOnInsertMode": false,
    "coc.preferences.formatOnSaveFiletypes": [],
    "eslint.autoFixOnSave": false,
    "stylelintplus.enable": true,
    "stylelintplus.cssInJs": true,
    "stylelintplus.autoFixOnSave": false,
    "css.validate": false,
    "html.validate.scripts": true,
    "html.validate.styles": true,
    "json.format.enable": true,
    "snippets.ultisnips.enable": true,
    "snippets.ultisnips.directories": [
        "UltiSnips",
        "~/.vim/UltiSnips"
    ],
    "snippets.userSnippetsDirectory": "~/.vim/UltiSnips",
    "suggest.completionItemKindLabels": {
        "snippet": "◉"
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": false
    },
    "python.linting.enabled": true,
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.diagnosticMode": "openFilesOnly",
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.organizeImports": true
        }
    }
}
